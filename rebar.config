{minimum_otp_vsn, "21"}.

{erl_opts, [
    debug_info,
    warn_unused_vars,
    nowarn_export_all
]}.

{deps, []}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{shell, [
  % {config, "config/sys.config"},
    {apps, [sipalerts]}
]}.
