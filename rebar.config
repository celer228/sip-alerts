{minimum_otp_vsn, "21"}.

{erl_opts, [
    debug_info,
    % {d, 'DEBUGER'},
    warn_unused_vars,
    nowarn_export_all
]}.

{eunit_opts, [verbose]}.

{deps, [{nksip, {git, "https://github.com/netcomposer/nksip", {tag, "v0.6.1"}}},
    {meck, "0.8.12"},
    {lager, "3.9.2"},
    {jsx, "3.1.0"}]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{shell, [
  % {config, "config/sys.config"},
    {apps, [cowboy, sipalerts]}
]}.
