otp_path: "/usr/local/lib/erlang/"
plt_path: "_build/default/rebar3_21.3.8.24_plt"
apps_dirs:
  - "_build/default/lib/*"
  - "/usr/local/lib/erlang/lib/*"
deps_dirs:
  - "_build/default/lib/*"
include_dirs:
  - "_build/default/lib/*/include"
  - "_build/default/lib/"
  - "include"
  - "/usr/local/lib/erlang/lib/"
  - "/usr/local/lib/erlang/lib/*/include"
diagnostics:
  enabled:
    - dialyzer