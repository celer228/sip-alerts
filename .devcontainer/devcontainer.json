{
    "name": "SIP alerts dev container",
    "dockerComposeFile": ["compose.dev.yml"],
    "service": "sip-alerts",
    "workspaceFolder": "/workspace",
    
    "customizations": {
        "vscode": {
            "settings": {
                "extensions.autoCheckUpdates": false,
				"extensions.autoUpdate": false,
                "extensions.verifySignature": false,
                "[erlang]": {
                    // форматтер erlang_ls ломает русский текст в комментах
                    "editor.defaultFormatter": "szTheory.erlang-formatter"
                }
            },
            "extensions": [
                "erlang-ls.erlang-ls@0.0.32",
                "szTheory.erlang-formatter@1.0.0"
            ]
        }
    }
}